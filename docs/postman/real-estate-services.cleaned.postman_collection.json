  "item": [
    {
      "name": "00 Auth",
      "item": [
        {
          "name": "Login (Save user_token + otp_code)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let json = {};",
                  "try { json = pm.response.json(); } catch (e) {}",
                  "const token = json?.data?.token || json?.token || null;",
                  "const otp = json?.data?.otp_code || json?.otp_code || null;",
                  "if (token) pm.environment.set('user_token', token);",
                  "if (otp) pm.environment.set('otp_code', otp);",
                  "pm.test('Login response is successful', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "phone", "value": "0991000001", "type": "text" },
                { "key": "password", "value": "password123", "type": "text" },
                { "key": "fcm_token", "value": "{{fcm_token}}", "type": "text", "disabled": true }
              ]
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Verify OTP (Optional)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let json = {};",
                  "try { json = pm.response.json(); } catch (e) {}",
                  "const token = json?.data?.token || json?.token || null;",
                  "if (token) pm.environment.set('user_token', token);",
                  "pm.test('Verify OTP response is successful', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "phone", "value": "0991000001", "type": "text" },
                { "key": "code", "value": "{{otp_code}}", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/auth/verify-otp",
              "host": ["{{base_url}}"],
              "path": ["auth", "verify-otp"]
            }
          }
        },

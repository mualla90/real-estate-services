    {
      "name": "20 Chat",
      "item": [
        {
          "name": "Create Conversation (Save conversation_id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let json = {};",
                  "try { json = pm.response.json(); } catch (e) {}",
                  "const conversationId = json?.data?.id || json?.id || null;",
                  "if (conversationId) pm.environment.set('conversation_id', conversationId);",
                  "pm.test('Conversation created/fetched', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{user_token}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"service_id\": {{target_service_id}}\n}",
              "options": {
                "raw": { "language": "json" }
              }
            },
            "url": {
              "raw": "{{base_url}}/business-accounts/{{business_account_id}}/conversations",
              "host": ["{{base_url}}"],
              "path": ["business-accounts", "{{business_account_id}}", "conversations"]
            }
          }
        },
        {
          "name": "Send Message",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{user_token}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"Hello, this is a realtime test message.\"\n}",
              "options": {
                "raw": { "language": "json" }
              }
            },
            "url": {
              "raw": "{{base_url}}/business-accounts/{{business_account_id}}/conversations/{{conversation_id}}/messages",
              "host": ["{{base_url}}"],
              "path": ["business-accounts", "{{business_account_id}}", "conversations", "{{conversation_id}}", "messages"]
            }
